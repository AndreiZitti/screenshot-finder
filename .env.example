# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Service
GEMINI_API_KEY=your-gemini-key

# Private access
# Comma-separated emails allowed to use the app in production.
# Production deploys fail closed when this is empty.
APP_ALLOWED_EMAILS=you@example.com

# Notion Integration (optional - for owner's default credentials)
# NOTION_API_KEY=secret_xxx
# NOTION_PAGE_ID=abc123def456
